<Page x:Class="ShoesShop.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Login: "/>
        <TextBox x:Name="loginbox" Width="100"/>
        <Button x:Name="loginbtn" Content="Войти" Width="50" Click="loginbtn_Click"/>
        <Button x:Name="guestbtn" Content="Гостевой доступ" Width="100" Click="guestbtn_Click"/>
    </StackPanel>
</Page>
