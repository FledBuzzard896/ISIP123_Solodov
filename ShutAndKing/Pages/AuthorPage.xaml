<Page x:Class="ShutAndKing.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage">

    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ваши опубликованные книги" FontSize="20" Margin="5" HorizontalAlignment="Center" Grid.Row="0"/>

            <ListBox x:Name="PublishedBooks_LB" Margin="5" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Этот элемент отвечает за перенос строк -->
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="200" Width="125">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Image Source="/Images/no_image.png"
							    Stretch="Fill"
							    Margin="10,0"
							    Grid.Row="0"
							    HorizontalAlignment="Center"/>

                            <ScrollViewer Margin="10,0" Grid.Row="1" MaxHeight="50" VerticalScrollBarVisibility="Hidden">
                                <TextBlock x:Name="BookName" Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <Button x:Name="EditBtn"
							    Margin="10,0"
							    Content="Редактировать"
							    Grid.Row="2" 
							    Tag="{Binding}" 
							    Click="AddOrEditBookBtn_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="AddNewBookBtn"
			    Content="Добавить книгу" FontSize="14"
			    Margin="5" 
			    Width="125" Height="35"
			    HorizontalAlignment="Center"
			    Grid.Row="2"
			    Tag="{Binding}" 
			    Click="AddOrEditBookBtn_Click"/>

            <TextBlock Text="Ваши замороженные книги" FontSize="20" Margin="5" HorizontalAlignment="Center" Grid.Row="3"/>

            <ListBox x:Name="FrozenBooks_LB" Margin="5" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="4">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Этот элемент отвечает за перенос строк -->
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="200" Width="125">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Image Source="/Images/no_image.png"
							    Stretch="Fill"
							    Margin="10,0"
							    Grid.Row="0"
							    HorizontalAlignment="Center"/>

                            <ScrollViewer Margin="10,0" Grid.Row="1" MaxHeight="50" VerticalScrollBarVisibility="Hidden">
                                <TextBlock x:Name="BookName" Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <Button x:Name="UnFrostingBtn"
							    Margin="10,0"
							    Content="Оспорить заморозку"
							    Grid.Row="2" 
							    Tag="{Binding}" 
							    Click="UnFrostingBtn_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </ScrollViewer>
</Page>
