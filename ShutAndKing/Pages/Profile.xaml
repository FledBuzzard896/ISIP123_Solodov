<Page x:Class="ShutAndKing.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Profile">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Margin="5"
		    Text="Информация:" FontSize="20"
		    HorizontalAlignment="Center"
		    Grid.Row="0" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5" Orientation="Vertical">
            <TextBlock Text="Имя:" Margin="2" FontSize="14"/>
            <TextBlock x:Name="nameTB" Text="" Margin="2" FontSize="14"/>
            <TextBlock Text="Логин:" Margin="2" FontSize="14"/>
            <TextBlock x:Name="loginTB" Text="" Margin="2" FontSize="14"/>
            <TextBlock Text="Электронная почта:" Margin="2" FontSize="14"/>
            <TextBlock x:Name="mailTB" Text="" Margin="2" FontSize="14"/>
            <TextBlock Text="Роль:" Margin="2" FontSize="14"/>
            <TextBlock x:Name="roleTB" Text="" Margin="2" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5" Orientation="Vertical" HorizontalAlignment="Center">
            <Button x:Name="AuthorApplicationBtn"
			    Content="Стать автором" FontSize="14" 
			    Width="125" Height="30"
			    Margin="5"
			    Click="AuthorApplicationBtn_Click"/>
            <TextBlock x:Name="isFrozen" Text="Не заморожен" ToolTip="Индикатор заморозки аккаунта" HorizontalAlignment="Center" FontSize="14" Margin="5"/>
            <Button x:Name="UnFreezeBtn"
			    Content="Оспорить заморозку" FontSize="14"
			    Width="100" Height="25"
			    Margin="5"
			    Click="UnFreezeBtn_Click" 
			    Visibility="Collapsed"/>
        </StackPanel>

        <ListBox x:Name="Reviews_LB" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,10,10">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding User.Name}" FontSize="14"/>
                        <TextBlock Text="{Binding Books.Title, StringFormat={}Книга: {0}}" FontSize="14" Margin="5,0,0,0"/>
                        <ScrollViewer Margin="5,0,5,0" MaxHeight="100">
                            <TextBlock Text="{Binding Comment}" FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <TextBlock Text="{Binding Rating, StringFormat={}Оценка: {0}}" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding DateOfReview, StringFormat={}Дата отзыва: {0}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
