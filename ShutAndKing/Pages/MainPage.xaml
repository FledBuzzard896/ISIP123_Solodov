<Page x:Class="ShutAndKing.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <Button x:Name="ExitBtn" Grid.Column="0" Content="Выйти" Margin="10" Click="ExitBtn_Click"/>
        <Button x:Name="AccountBtn" Grid.Column="2" Margin="10" Click="AccountBtn_Click">
            <Image Source="/Images/squidward.png" IsHitTestVisible="False"/>
        </Button>

        <Grid x:Name="Catalog_Grid" Margin="5" Grid.Row="1" Grid.Column="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Текст "Найти:" -->
                    <ColumnDefinition Width="*"/>
                    <!-- Поле ввода (занимает все оставшееся место) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Выпадающие списки -->
                </Grid.ColumnDefinitions>

                <TextBlock Text="Найти: " FontSize="16" VerticalAlignment="Center" Grid.Column="0"/>
                <TextBox x:Name="searchTB" Margin="5" Height="20" Grid.Column="1" VerticalAlignment="Center" KeyDown="Enter_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox x:Name="filter_box" Width="auto" ToolTip="Фильтрация" FontSize="14" Margin="5" SelectionChanged="filter_box_SelectionChanged"/>
                    <ComboBox x:Name="sorting_box" Width="auto" ToolTip="Сортировка" FontSize="14" Margin="5" SelectionChanged="sorting_box_SelectionChanged"/>
                </StackPanel>
            </Grid>
            <ListBox x:Name="Books_LB" Margin="5" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Этот элемент отвечает за перенос строк -->
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="200" Width="125">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Image Source="/Images/no_image.png" Stretch="Fill" Margin="10,0" Grid.Row="0" HorizontalAlignment="Center"/>
                            <ScrollViewer Margin="10,0" Grid.Row="1" MaxHeight="50" VerticalScrollBarVisibility="Hidden">
                                <TextBlock x:Name="BookName" Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            </ScrollViewer>
                            <TextBlock x:Name="AuthorName" Text="{Binding Name}" FontSize="12"  MaxHeight="25" Margin="10,0" TextWrapping="Wrap" Grid.Row="2"/>
                            <Button x:Name="AddToListBtn" Margin="10,0" Content="Добавить" Grid.Row="3" Click="AddToList_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.Row="1" Grid.Column="2" Margin="10">
            <StackPanel Orientation="Vertical">
                <Button x:Name="BooksCatalogBtn" ToolTip="Каталог книг" Margin="10,5,10,5" ToolTipService.InitialShowDelay="0" Click="BooksCatalogBtn_Click">
                    <Image Source="/Images/book.jpg" IsHitTestVisible="False"/>
                </Button>
                <Button x:Name="BooksListsBtn" ToolTip="Списки книг" Margin="10,5,10,5" ToolTipService.InitialShowDelay="0" Click="BooksListsBtn_Click">
                    <Image Source="/Images/lists.jpg" IsHitTestVisible="False"/>
                </Button>
                <Button x:Name="AdministrationBtn" ToolTip="Администрирование" Margin="10,5,10,5" ToolTipService.InitialShowDelay="0" Click="AdministrationBtn_Click">
                    <Image Source="/Images/admin.png" IsHitTestVisible="False"/>
                </Button>
                <Button x:Name="AuthorPageBtn" ToolTip="Страница автора" Margin="10,5,10,5" ToolTipService.InitialShowDelay="0" Click="AuthorPageBtn_Click">
                    <Image Source="/Images/author.png" IsHitTestVisible="False"/>
                </Button>
                <Button x:Name="GreenFlagBtn" ToolTip="Аккаунт не заморожен" Margin="10,5,10,5" ToolTipService.InitialShowDelay="0" Visibility="Visible" Click="GreenFlagBtn_Click">
                    <Image Source="/Images/greenflag.jpg" IsHitTestVisible="False"/>
                </Button>
                <Button x:Name="RedFlagBtn" ToolTip="Аккаунт заморожен" Margin="10,5,10,5" ToolTipService.InitialShowDelay="0" Visibility="Collapsed" Click="RedFlagBtn_Click">
                    <Image Source="/Images/redflag.png" IsHitTestVisible="False"/>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
