<Page x:Class="ShutAndKing.Pages.AdministrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdministrationPage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левое меню -->
            <ListBox x:Name="MenuListBox" 
                 SelectionChanged="MenuListBox_SelectionChanged"
                 FontSize="14">
                <ListBoxItem Content="Жалобы" Tag="Complaints"/>
                <ListBoxItem Content="Заявки на разморозку" Tag="Defrost"/>
                <ListBoxItem Content="Заявки на авторство" Tag="AuthorRole"/>
                <ListBoxItem Content="Замороженные" Tag="Frozen"/>
                <ListBoxItem Content="Пользователи" Tag="Users"/>
            </ListBox>

            <!-- Правая область – все панели переключаются через Visibility -->
            <Grid Grid.Column="1" Margin="10,0,0,0">

                <!-- 1. Жалобы -->
                <Grid x:Name="Panel_Complaints" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ComplaintsGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="Объект жалобы" Binding="{Binding Target}" Width="200"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                        <Button Content="Принять" Width="80" Margin="5" Click="AcceptComplaint_Click"/>
                        <Button Content="Отклонить" Width="80" Margin="5" Click="RejectComplaint_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Заявки на разморозку -->
                <Grid x:Name="Panel_DefrostRequests" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DefrostRequestsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TargetType}" Width="100"/>
                            <DataGridTextColumn Header="ID объекта" Binding="{Binding TargetID}" Width="80"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                        <Button Content="Принять" Width="80" Margin="5" Click="AcceptDefrost_Click"/>
                        <Button Content="Отклонить" Width="80" Margin="5" Click="RejectDefrost_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Заявки на авторство -->
                <Grid x:Name="Panel_AuthorRequests" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AuthorRequestsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                        <Button Content="Принять" Width="80" Margin="5" Click="AcceptAuthorRole_Click"/>
                        <Button Content="Отклонить" Width="80" Margin="5" Click="RejectAuthorRole_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Замороженные сущности (книги, пользователи, отзывы) -->
                <Grid x:Name="Panel_Frozen" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel>
                            <Expander Header="Замороженные книги" IsExpanded="True">
                                <DataGrid x:Name="FrozenBooksGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="200"/>
                            </Expander>
                            <Expander Header="Замороженные пользователи" IsExpanded="True">
                                <DataGrid x:Name="FrozenUsersGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="200"/>
                            </Expander>
                            <Expander Header="Замороженные отзывы" IsExpanded="True">
                                <DataGrid x:Name="FrozenReviewsGrid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="200"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. Управление пользователями -->
                <Grid x:Name="Panel_Users" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                            <DataGridTemplateColumn Header="Действия">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Сменить пароль" Width="100" Margin="5" Click="ChangePassword_Click" Tag="{Binding}"/>
                                            <Button Content="Назначить роль" Width="100" Margin="5" Click="AssignRole_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Добавить пользователя" Width="150" Height="25" Margin="5" HorizontalAlignment="Right" Click="AddUser_Click"/>
                </Grid>

            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
