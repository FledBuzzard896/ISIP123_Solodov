<Page x:Class="ShutAndKing.Pages.PageOfBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageOfBook">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" Content="Назад" Width="75" Height="20" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackBtn_Click"/>
            <!-- Заголовок -->
            <TextBlock x:Name="top_TB" 
                   FontSize="20" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,5" 
                   Grid.Row="0" Grid.ColumnSpan="2"/>

            <!-- Обложка -->
            <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0">
                <Image x:Name="book_cover" 
				   Source="/Images/no_image.png" 
				   Height="150"/>
                <Button x:Name="AddToListBtn" Margin="15" Height="20" Width="100" Content="Добавить" Click="AddToList_Click"/>
            </StackPanel>
            <!-- Информация о книге -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                <TextBlock Text="Название:" FontSize="14" Margin="0,5,0,0"/>
                <TextBlock x:Name="book_name" FontSize="14" Margin="0,5,0,5"/>

                <TextBlock Text="Описание:" FontSize="14" Margin="0,5,0,0"/>
                <ScrollViewer Margin="0,5,0,5" MaxHeight="200" VerticalScrollBarVisibility="Hidden">
                    <TextBlock x:Name="book_descript" FontSize="12" TextWrapping="Wrap"/>
                </ScrollViewer>

                <TextBlock Text="Жанры:" FontSize="14" Margin="0,5,0,0"/>
                <TextBlock x:Name="book_genres" FontSize="14" Margin="0,5,0,5"/>

                <TextBlock Text="Автор:" FontSize="14" Margin="0,5,0,0"/>
                <TextBlock x:Name="book_author" FontSize="14" Margin="0,5,0,5"/>

                <TextBlock Text="Рейтинг:" FontSize="14" Margin="0,5,0,0"/>
                <TextBlock x:Name="book_rating" FontSize="14" Margin="0,5,0,5"/>
            </StackPanel>

            <!-- Кнопка заморозки книги для администратора -->
            <Button x:Name="freezeBookBtn" 
                Content="Заморозить книгу" 
                Width="120" Height="25" 
                HorizontalAlignment="Right" 
                Margin="0,5,10,5"
                Grid.Row="2" Grid.Column="1"
                Visibility="Collapsed"
                Click="FreezeBook_Click"/>

            <!-- Текст книги -->
            <ScrollViewer Margin="0,5,0,5" Grid.Row="2" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="book_text" FontSize="12"/>
            </ScrollViewer>

            <!-- Блок жалоб -->
            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ЖАЛОБА НА КНИГУ:" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,5" 
                       Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="book_complaint" 
                     Margin="5" 
                     Grid.Row="1" Grid.Column="0" 
                     MaxLength="200"/>
                <Button x:Name="bookComplaintBtn" 
                    Content="Пожаловаться" 
                    Width="100" Height="20" 
                    HorizontalAlignment="Center" 
                    Grid.Row="2" Grid.Column="0" 
                    Click="BookComplaint_Click"/>

                <TextBlock Text="ЖАЛОБА НА АВТОРА:" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,5" 
                       Grid.Row="0" Grid.Column="1"/>
                <TextBox x:Name="author_complaint" 
                     Margin="5" 
                     Grid.Row="1" Grid.Column="1" 
                     MaxLength="200"/>
                <Button x:Name="authorComplaintBtn" 
                    Content="Пожаловаться" 
                    Width="100" Height="20" 
                    HorizontalAlignment="Center" 
                    Grid.Row="2" Grid.Column="1" 
                    Click="AuthorComplaint_Click"/>
            </Grid>

            <!-- Список отзывов -->
            <ListBox x:Name="Reviews_LB" Margin="5" Grid.Row="4" Grid.ColumnSpan="2">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{Binding User.Name}" FontSize="14"/>
                            <ScrollViewer Margin="5,0,5,0" MaxHeight="100">
                                <TextBlock Text="{Binding Comment}" FontSize="12" TextWrapping="Wrap"/>
                            </ScrollViewer>
                            <TextBlock Text="{Binding Rating, StringFormat={}Оценка: {0}}" 
                                   FontSize="14" Margin="0,0,5,0"/>

                            <Button x:Name="reviewComplaint" 
                                Content="Пожаловаться" 
                                Width="100" Height="20" 
                                Click="ReviewComplaint_Click"
                                Tag="{Binding}"/>
                            <!-- Кнопка заморозки отзыва для администратора -->
                            <Button x:Name="freezeReviewBtn" 
                                Content="Заморозить отзыв" 
                                Width="120" Height="20" 
                                Margin="5,0,0,0"
                                Visibility="Collapsed"
                                Click="FreezeReview_Click"
                                Tag="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </ScrollViewer>
</Page>
