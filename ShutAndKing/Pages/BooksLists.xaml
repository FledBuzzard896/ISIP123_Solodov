<Page x:Class="ShutAndKing.Pages.BooksLists"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BooksLists">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0">
            <Button x:Name="trashBtn"
			    Content="Заброшено" FontSize="14"
			    Height="20" Width="80"
			    IsEnabled="True"
			    Click="trashBtn_Click"/>
            <Button x:Name="plansBtn"
			    Content="В планах" FontSize="14"
			    Margin="10,0,5,0"
			    Height="20" Width="80"
			    IsEnabled="True"
			    Click="plansBtn_Click"/>
            <Button x:Name="readingBtn"
			    Content="Читаю" FontSize="14"
			    Margin="5,0,10,0"
			    Height="20" Width="80"
			    IsEnabled="False"
			    Click="readingBtn_CLick"/>
            <Button x:Name="alreadyReadBtn"
			    Content="Прочитано" FontSize="14"
			    Height="20" Width="80"
			    IsEnabled="True"
			    Click="alreadyReadBtn_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Текст "Найти:" -->
                <ColumnDefinition Width="*"/>
                <!-- Поле ввода (занимает все оставшееся место) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Выпадающие списки -->
            </Grid.ColumnDefinitions>

            <TextBlock Text="Найти: " FontSize="16" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox x:Name="searchTBox" Margin="5" Height="20" Grid.Column="1" VerticalAlignment="Center" KeyDown="Enter_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="filter_box" Width="auto" ToolTip="Фильтрация" FontSize="14" Margin="5" SelectionChanged="filter_box_SelectionChanged"/>
                <ComboBox x:Name="sorting_box" Width="auto" ToolTip="Сортировка" FontSize="14" Margin="5" SelectionChanged="sorting_box_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="BooksInLists_LB" Margin="5" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Этот элемент отвечает за перенос строк -->
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="200" Width="125">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Image Source="/Images/no_image.png"
						    Stretch="Fill"
						    Margin="10,0"
						    Grid.Row="0"
						    HorizontalAlignment="Center"/>

                        <ScrollViewer Margin="10,0" Grid.Row="1" MaxHeight="50" VerticalScrollBarVisibility="Hidden">
                            <TextBlock x:Name="BookName" Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <TextBlock x:Name="AuthorName"
						    Text="{Binding Users.Name}" FontSize="12"
						    MaxHeight="25"
						    Margin="10,0"
						    TextWrapping="Wrap"
						    Grid.Row="2"/>
                        <Button x:Name="ChangeListBtn"
						    Margin="10,0"
						    Content="Переместить в"
						    Grid.Row="3" 
						    Tag="{Binding}" 
						    Click="ChangeList_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
