<Page x:Class="ShutAndKing.Pages.WorkWithBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WorkWithBookPage">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" FontSize="14" Margin="5" Grid.Row="0"/>
        <TextBox x:Name="TitleTBox" Text="" FontSize="14" HorizontalAlignment="Stretch" Margin="5" Grid.Row="1"/>

        <TextBlock Text="Описание:" FontSize="14" Margin="5" Grid.Row="2"/>
        <ScrollViewer Margin="5" Grid.Row="3">
            <TextBox x:Name="DescriptionTBox" Text="" FontSize="14" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <TextBlock Text="Текст книги:" FontSize="14" Margin="5" Grid.Row="4"/>
        <ScrollViewer Margin="5" Grid.Row="5">
            <TextBox x:Name="TextTBox" Text="" FontSize="14" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" Grid.Row="6">
            <Button x:Name="SaveBtn" Content="Сохранить книгу" FontSize="14" Width="125" Height="30" Margin="0,0,15,0" Click="SaveBtn_Click"/>
            <Button x:Name="DeleteBtn" Content="Удалить книгу" FontSize="14" Width="125" Height="30" Click="DeleteBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
