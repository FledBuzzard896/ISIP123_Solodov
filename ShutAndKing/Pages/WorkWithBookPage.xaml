<Page x:Class="ShutAndKing.Pages.WorkWithBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShutAndKing.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WorkWithBookPage">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" FontSize="14" Margin="5,5,5,5" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="TitleTBox" Text="" FontSize="14" Margin="5,5,5,5" Grid.Row="1" Grid.Column="0"/>

        <TextBlock Text="Жанр:" FontSize="14" Margin="5,5,5,5" Grid.Row="0" Grid.Column="1"/>
        <ComboBox x:Name="GenreBox" ItemsSource="{Binding GenresList}" Margin="5" Grid.Row="1" Grid.Column="1">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" 
                              IsChecked="{Binding IsSelected}" 
                              Margin="5,2"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Описание:" FontSize="14" Margin="5,5,5,5" Grid.Row="2" Grid.ColumnSpan="2"/>
        <ScrollViewer Margin="5,5,5,5" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBox x:Name="DescriptionTBox" Text="" FontSize="14" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <TextBlock Text="Текст книги:" FontSize="14" Margin="5,5,5,5" Grid.Row="4" Grid.ColumnSpan="2"/>
        <ScrollViewer Margin="5,5,5,5" Grid.Row="5" Grid.ColumnSpan="2">
            <TextBox x:Name="TextTBox" Text="" FontSize="14" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="262,5,0,5" Grid.Row="6" Grid.ColumnSpan="2">
            <Button x:Name="SaveBtn" Content="Сохранить книгу" FontSize="14" Width="125" Height="30" Margin="0,0,15,0" Click="SaveBtn_Click"/>
            <Button x:Name="DeleteBtn" Content="Удалить книгу" FontSize="14" Width="125" Height="30" Click="DeleteBtn_Click"/>
        </StackPanel>

        <Button x:Name="BackBtn" Content="Назад" Width="55" Height="20" Margin="5,10,0,10" Grid.Row="6" HorizontalAlignment="Left" Click="BackBtn_Click"/>
    </Grid>
</Page>
