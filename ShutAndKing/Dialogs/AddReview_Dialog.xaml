<Window x:Class="ShutAndKing.Dialogs.AddReview_Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutAndKing.Dialogs"
        mc:Ignorable="d"
        Title="AddReview_Dialog" Height="400" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button Content="Закрыть" HorizontalAlignment="Left" Width="55" Height="20" Margin="10,5,5,5" Click="Close_Click"/>
        <TextBlock Text="Напишите свой отзыв:" Grid.Row="1" HorizontalAlignment="Center"/>
        <TextBox x:Name="ReviewTBox" Grid.Row="2" Margin="10"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Выберите оценку:" Margin="0,0,16,0"/>
            <ComboBox x:Name="ReviewRating" Width="100"/>
        </StackPanel>
        <Button Content="Отправить отзыв" HorizontalAlignment="Center" Grid.Row="4" Height="20" Width="100" Margin="10" Click="Send_Click"/>
    </Grid>
</Window>
