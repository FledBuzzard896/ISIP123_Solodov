<Window x:Class="ShutAndKing.AddToLists_Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutAndKing"
        mc:Ignorable="d"
        Title="AddToLists_Dialog" Height="300" Width="200">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ADD TO:" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0"/>
        <ItemsControl x:Name="lists" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding Title}" IsChecked="{Binding IsSelected}" GroupName="RL" VerticalContentAlignment="Center" Margin="0,5,0,5"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BackBtn" Content="Отмена" Width="80" Height="20" Click="BackBtn_Click" Margin="0,0,10,0"/>
            <Button x:Name="AddBtn" Content="Добавить" Width="80" Height="20" Click="AddBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>
