<Window x:Class="ShutAndKing.Dialogs.AuthorApplication_Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutAndKing.Dialogs"
        mc:Ignorable="d"
        Title="AuthorApplication_Dialog" Height="400" Width="350">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="CloseBtn"
		    Content="Закрыть" FontSize="14"
		    Width="75" Height="20"
		    Grid.Row="0"
		    HorizontalAlignment="Left"
		    Click="CloseBtn_Click"/>
        <TextBlock Text="Заявление на Авторство" FontSize="14" Margin="5" HorizontalAlignment="Center" Grid.Row="0"/>
        <TextBox x:Name="reasonTBox" FontSize="12" MaxLength="300" Margin="0,5,0,5" Grid.Row="1"/>
        <Button x:Name="SendReasonBtn"
		    Content="Отправить" FontSize="14"
		    Width="100" Height="20"
		    Grid.Row="2"
		    HorizontalAlignment="Center"
		    Click="SendReasonBtn_Click"/>
    </Grid>
</Window>
