<Window x:Class="ShutAndKing.Dialogs.ChangeListForBook_Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutAndKing.Dialogs"
        mc:Ignorable="d"
        Title="ChangeListForBook_Dialog" Height="400" Width="300">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="top"
		Margin="5"
		FontSize="20"
		HorizontalAlignment="Center"
		Grid.Row="0" Grid.ColumnSpan="2"/>

        <Button x:Name="CloseBtn" Content="Закрыть" Width="75" Height="20" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="5" Click="CloseBtn_Click"/>

        <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Переместить из:" FontSize="14" Margin="5" Grid.Row="0"/>
            <ComboBox x:Name="From_ComboBox" Width="auto" Margin="5" Grid.Row="1"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Переместить в:" FontSize="14" Margin="5" Grid.Row="0"/>
            <ComboBox x:Name="To_ComboBox" Width="auto" Margin="5" Grid.Row="1"/>
        </Grid>

        <Button x:Name="ChangeBtn"
		Content="Выполнить" FontSize="14"
		Width="125" Height="30"
		Margin="5"
		HorizontalAlignment="Center"
		Grid.Row="2" Grid.ColumnSpan="2"
		Click="ChangeBtn_Click"/>
    </Grid>
</Window>
