<Window x:Class="ShutAndKing.Dialogs.ReviewComplaint_Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutAndKing.Dialogs"
        mc:Ignorable="d"
        Title="ReviewComplaint_Dialog" Height="400" Width="350">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="top" Text="Жалоба на обзор: ID" FontSize="14" HorizontalAlignment="Center" Grid.Row="0"/>
        <Button x:Name="CloseBtn" 
            Content="Закрыть" FontSize="14"
            Width="75" Height="20" 
            Click="CloseBtn_Click" 
            HorizontalAlignment="Left" 
            Grid.Row="0"/>

        <StackPanel Orientation="Vertical" Margin="0,5,0,5" Grid.Row="1">
            <TextBlock Text="Введите жалобу:" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="Complaint_TBox" MaxLength="200" FontSize="12"/>
        </StackPanel>

        <Button x:Name="SendComplaintBtn"
		Content="Пожаловаться" FontSize="14"
		Width="125" Height="30"
		Click="SendComplaintBtn_Click"
		HorizontalAlignment="Center"
		Grid.Row="2"/>
    </Grid>
</Window>
