<Page x:Class="pr1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Логин: "/>
        <TextBox x:Name="login" Width="125" Margin="5"/>
        <Button x:Name="entryBtn" Content="Войти" Width="125" Click="entryBtn_Click"/>
        <Button x:Name="entryGuestBtn" Content="Войти как гость" Width="125" Click="entryGuestBtn_Click"/>
        <Button x:Name="regBtn" Content="Регистрация" Width="125" Click="regBtn_Click"/>
    </StackPanel>
</Page>
