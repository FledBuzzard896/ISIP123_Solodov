<Page x:Class="Nail_nail.Pages.Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Nail_nail.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Account">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Профиль -->
        <Grid Margin="10,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="16*"/>
                <RowDefinition Height="28*"/>
            </Grid.RowDefinitions>

            <Button x:Name="BackBtn" Content="Назад" Width="55" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Click="BackBtn_Click"/>

            <Image Source="{Binding Cover}" Grid.Row="1" Stretch="Fill"/>
            <StackPanel Orientation="Vertical" Margin="0,10,0,0" Grid.Row="2">
                <TextBlock Text="Имя: " Margin="0,0,0,10" FontSize="14"/>
                <TextBlock Text="{Binding FullName}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="14"/>
                <TextBlock Text="Телефон: " Margin="0,0,0,10" FontSize="14"/>
                <TextBlock Text="{Binding PhoneNumber}" Margin="0,0,0,10" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- История заказов и записей -->
        <Grid Margin="5,10,10,10" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="История заказов" FontSize="14" Margin="0,0,0,10" Grid.Row="0"/>
                <ListBox x:Name="OrderHistory" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Grid.Row="1">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Вместо WrapPanel используем VirtualizingStackPanel для вертикального списка -->
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дата оформления: "/>
                                    <TextBlock Text="{Binding OrderDateTime}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дата доставки: "/>
                                    <TextBlock Text="{Binding DeliveryDate}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Способ оплаты: "/>
                                    <TextBlock Text="{Binding PaymentMethod}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Выдан ли заказ: "/>
                                    <TextBlock Text="{Binding IsIssued}"/>
                                </StackPanel>
                                <TextBlock Text=""/>

                                <TextBlock Text="=========== Товары: ==========="/>
                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Общая стоимость: " Foreground="DarkGreen"/>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0} ₽}" Foreground="DarkGreen"/>
                                </StackPanel>
                                <TextBlock Text=""/>

                                <TextBlock Text="Комментарий к заказу:"/>
                                <TextBlock Text="{Binding Comment}" Foreground="Gray"/>
                                <TextBlock Text=""/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1" Margin="5,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="История записей" FontSize="14" Margin="0,0,0,10" Grid.Row="0"/>
                <ListBox x:Name="RecordHistory" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Grid.Row="1">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Вместо WrapPanel используем VirtualizingStackPanel для вертикального списка -->
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,0,5">
                                <TextBlock Text="{Binding Master, StringFormat={}Мастер: {0}}"/>
                                <TextBlock Text="{Binding Service, StringFormat={}Услуга: {0}}"/>
                                <TextBlock Text="{Binding AppointmentDateTime, StringFormat={}Дата записи: {0}}"/>
                                <TextBlock Text="{Binding PaymentMethod, StringFormat={}Способ оплаты: {0}}"/>
                                <TextBlock Text=""/>
                                <StackPanel>
                                    <TextBlock Text="Комментарий: "/>
                                    <TextBlock Text="{Binding Comment}" Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Text=""/>
                                <TextBlock Text="{Binding TotalPrice, StringFormat={}Стоимость: {0} ₽}" Foreground="DarkGreen"/>
                                <TextBlock Text=""/>
                                <TextBlock Text="{Binding IsCompleted, StringFormat={}Выполнена ли услуга: {0}}"/>
                                <TextBlock Text="{Binding IsCancelled, StringFormat={}Отменена ли услуга: {0}}"/>
                                <TextBlock Text=""/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Page>
