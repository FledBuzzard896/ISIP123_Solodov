<Page x:Class="Nail_nail.Pages.Cart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Nail_nail.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Cart">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="400*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button x:Name="BackBtn" Content="Назад" Width="50" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackBtn_Click"/>
            <TextBlock Text="КОРЗИНА:" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="ShoppingCart_LB" Margin="0,0,0,5" BorderThickness="0" Padding="0" ScrollViewer.CanContentScroll="False" Grid.Row="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" Margin="0,5,5,5" Grid.Column="0">
                                <TextBlock Text="{Binding ProductName}" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Rating, StringFormat={}Оценка: {0}}" FontSize="14"/>
                            </StackPanel>

                            <ScrollViewer Margin="0,5,5,5" Grid.Column="1" VerticalScrollBarVisibility="Hidden">
                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" />
                            </ScrollViewer>

                            <TextBlock Text="{Binding TypeName, StringFormat={}Тип: {0}}" FontSize="12" Margin="0,5,5,5" TextWrapping="Wrap" Grid.Column="2"/>
                            <TextBlock Text="{Binding ManufacturerName}" FontSize="12" Margin="0,5,5,5" Grid.Column="3"/>

                            <Grid Margin="0,5,5,5" Grid.Column="4" HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Price, StringFormat={}{0}₽}" FontSize="14" Grid.Column="1"/>
                                <TextBlock Text="{Binding DiscountPercent, StringFormat={}Скидка: {0}%}" FontSize="14"  Grid.Column="0"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="ВСЕГО:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Grid.Row="1"/>
            <TextBlock x:Name="FinalPrice" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Grid.Row="1"/>
        </Grid>

        <Button x:Name="PaymentBtn" Content="Оформить" Width="100" Height="20" Background="DarkGreen" Grid.Row="2" Click="PaymentBtn_Click"/>
    </Grid>
</Page>
