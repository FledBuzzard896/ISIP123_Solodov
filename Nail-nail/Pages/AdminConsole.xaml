<Page x:Class="Nail_nail.Pages.AdminConsole"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Nail_nail.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="AdminConsole">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="main" Foreground="White" TextWrapping="Wrap" Grid.Row="0" Margin="5,5,5,0"/>
        <Grid Grid.Row="1" Margin="5,10,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text=">>>" Foreground="Green" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" Grid.Column="0" Margin="0,0,2,0"/>
            <TextBox Foreground="Purple" Background="Transparent" BorderBrush="Transparent" Grid.Column="1"/>
        </Grid>
    </Grid>
</Page>
