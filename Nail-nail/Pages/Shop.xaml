<Page x:Class="Nail_nail.Pages.Shop"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Nail_nail.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Shop">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Салон Страсти и Гламура - NailNail" FontSize="20" VerticalAlignment="Center" FontStyle="Italic"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Record" Content="Записаться" Width="70" Height="20" Margin="0,0,10,0" Click="Records_ButtonClick"/>
            <Button x:Name="AccountLogIn" Content="Войти" Width="70" Height="20" Visibility="Visible" Click="Account_ButtonClick"/>
            <Button x:Name="Account" Width="30" Height="30" Visibility="Collapsed" Click="Account_ButtonClick">
                <Image Source="/Images/incognita.png"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>    <!-- Текст "Найти:" -->
                <ColumnDefinition Width="*"/>       <!-- Поле ввода (занимает все оставшееся место) -->
                <ColumnDefinition Width="Auto"/>    <!-- Выпадающие списки -->
            </Grid.ColumnDefinitions>

            <TextBlock Text="Найти: " FontSize="16" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox x:Name="searchTB" Margin="5" Height="20" Grid.Column="1" VerticalAlignment="Center" KeyDown="Enter_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="filter_box" Width="auto" ToolTip="Фильтрация" FontSize="14" Margin="5" SelectionChanged="filter_box_SelectionChanged"/>
                <ComboBox x:Name="sorting_box" Width="auto" ToolTip="Сортировка" FontSize="14" Margin="5" SelectionChanged="sorting_box_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="ProductsLB" Margin="5" Grid.Row="2" BorderThickness="0" Padding="0" ScrollViewer.CanContentScroll="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighDiscount}" Value="True">
                            <Setter Property="Background" Value="LightCoral"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Vertical" Margin="0,5,5,5" Grid.Column="0">
                            <TextBlock Text="{Binding ProductName}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Rating, StringFormat={}Оценка: {0}}" FontSize="14"/>
                        </StackPanel>
                        
                        <ScrollViewer Margin="0,5,5,5" Grid.Column="1" VerticalScrollBarVisibility="Hidden">
                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>

                        <TextBlock Text="{Binding TypeName, StringFormat={}Тип: {0}}" FontSize="12" Margin="0,5,5,5" TextWrapping="Wrap" Grid.Column="2"/>
                        <TextBlock Text="{Binding ManufacturerName}" FontSize="12" Margin="0,5,5,5" Grid.Column="3"/>
                        
                        <Grid Margin="0,5,5,5" Grid.Column="4" HorizontalAlignment="Right">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Price, StringFormat={}{0}₽}" FontSize="14" Margin="0,0,5,5" Grid.Row="0" Grid.Column="0"/>
                            <TextBlock Text="{Binding DiscountPercent, StringFormat={}Скидка: {0}%}" FontSize="14" Margin="0,0,0,5" Grid.Row="0" Grid.Column="1"/>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation = "Horizontal" HorizontalAlignment = "Center">
                                <Button x:Name="BuyBtn" Content="Купить" FontSize="14" Tag="{Binding ProductObject}" Click="BuyDeleteProduct_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name ="GoToCart" Content="Перейти в корзину" FontSize="14" Height="30" Width="150" Grid.Row="3" HorizontalAlignment="Right" Click="GoToCart_Click"/>
    </Grid>
</Page>
