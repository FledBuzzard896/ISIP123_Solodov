<Page x:Class="ISIP123_Solodov_WPF.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid Background="#181a21">
        <Image Source="/Images/stem-logo-nobg.png"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Width="100" Margin="10"/>
        
        <Border
            BorderBrush="#32353c"
            BorderThickness="2"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
            <StackPanel Background="#181a21" Margin="20">
                <TextBlock Text="ВОЙДИТЕ ИСПОЛЬЗУЯ ИМЯ АККАУНТА" Foreground="#1999ff"/>
                <TextBox x:Name="loginBox"
                         Margin="0,5,0,0" 
                         Height="35" Width="400" 
                         Background="#32353c" Foreground="White" 
                         BorderThickness="0"/>
                
                <TextBlock Text="ПАРОЛЬ" Foreground="#afb1b8" Margin="0,10,0,0"/>
                <PasswordBox x:Name="passwordBox" 
                             Margin="0,5,0,0" 
                             Height="35" Width="400" 
                             Background="#32353c" Foreground="White" 
                             BorderThickness="0" 
                             PasswordChar="•"/>
                
                <Button x:Name="enterBtn" 
                        Content="Войти" 
                        Height="35" 
                        Background="#1999ff" Foreground="White"
                        Margin="100,20,100,10" 
                        BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
